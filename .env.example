# Supabase (Proje ayarları > API bölümünden alın)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Demo modu (login olmadan panele girmek için) ---
# true: auth kapısı kapanır, sabit demo kullanıcı (Ayşe / Örnek İthalat) ile girilir.
# Bu durumda aşağıdaki JWT Secret zorunludur (veri okuma bunun üzerinden RLS ile yapılır).
NEXT_PUBLIC_DEMO_MODE=true
# Supabase → Project Settings > API > JWT Settings > JWT Secret ile AYNI olmalı.
SUPABASE_JWT_SECRET=YOUR-SUPABASE-JWT-SECRET

# Yalnızca sunucu tarafı yönetim işleri için (opsiyonel, panelde kullanılmaz)
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
